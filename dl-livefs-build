#!/usr/bin/python3

# derived from
# https://raw.githubusercontent.com/Textualize/rich/master/examples/downloader.py

# given a build url, download the bits
# example build url:
# https://launchpad.net/~dbungert/+livefs/ubuntu/oracular/test/+build/684314

import argparse
import os
import os.path
import signal
import sys
from concurrent.futures import ThreadPoolExecutor
from functools import partial
from threading import Event
from typing import Iterable
from urllib.request import urlopen

from launchpadlib.launchpad import Launchpad
from rich.progress import (BarColumn, DownloadColumn, Progress, TaskID,
                           TextColumn, TimeRemainingColumn,
                           TransferSpeedColumn)

progress = Progress(
    TextColumn("[bold blue]{task.fields[filename]}", justify="right"),
    "[progress.percentage]{task.percentage:>3.1f}%",
    DownloadColumn(),
    TransferSpeedColumn(),
)


done_event = Event()


def handle_sigint(signum, frame):
    done_event.set()


signal.signal(signal.SIGINT, handle_sigint)


def copy_url(task_id: TaskID, url: str, path: str) -> None:
    """Copy data from a url to a local file."""
    response = urlopen(url)
    # This will break if the response doesn't contain content length
    progress.update(task_id, total=int(response.info()["Content-length"]))
    with open(path, "wb") as dest_file:
        progress.start_task(task_id)
        for data in iter(partial(response.read, 32768), b""):
            dest_file.write(data)
            progress.update(task_id, advance=len(data))
            if done_event.is_set():
                return


def download(urls: Iterable[str], dest_dir: str):
    """Download multiple files to the given directory."""

    with progress:
        with ThreadPoolExecutor(max_workers=3) as pool:
            for url in urls:
                filename = url.split("/")[-1]
                dest_path = os.path.join(dest_dir, filename)
                task_id = progress.add_task("download", filename=filename, start=False)
                pool.submit(copy_url, task_id, url, dest_path)

def get_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("build", help="url")
    return parser.parse_args()


def get_built_files_urls(url):
    before, _, after = url.partition('~')
    owner, _, distro, series, name, _, find_build_id = after.split('/')

    with progress.console.status('login'):
        lp = Launchpad.login_with('sru-scanner', 'production', version='devel')
        distro = lp.distributions[distro]
        series = distro.getSeries(name_or_version=series)

    with progress.console.status('get livefs by name'):
        f = lp.livefses.getByName(
            distro_series=series, owner=lp.people[owner], name=name)

    with progress.console.status('looking for buildid'):
        for build in f.builds:
            web_link = build.web_link
            build_id = web_link.split('/')[-1]
            if build_id == find_build_id:
                target_build = build
                break
        else:
            progress.console.print(f"build {find_build_id} not found")
            sys.exit(1)

    urls = target_build.getFileUrls()
    return urls


def main():
    args = get_args()
    urls = get_built_files_urls(args.build)
    download(urls, ".")
    progress.console.log("done")


if __name__ == "__main__":
    main()
